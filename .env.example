# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# Flask session-cookie signing key (web login). Any long random string.
SECRET_KEY=change-me

# JWT signing key for the /api/v1 token-auth surface. Any long random
# string -- generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me

# PostgreSQL connection string.
DATABASE_URL=postgresql://username:password@localhost/college_predictor

# Used by the AI counselor (services/openai_service.py).
OPENAI_API_KEY=sk-your-openai-api-key
