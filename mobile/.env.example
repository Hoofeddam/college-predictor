# Copy this file to .env. Not committed (see .gitignore).
#
# Origin of the Flask backend, no trailing slash, no /api/v1 suffix.
# 127.0.0.1 works for Expo web (same machine as the backend). A physical
# device or emulator needs your machine's LAN IP instead.
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000
